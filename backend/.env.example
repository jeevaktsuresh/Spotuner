# ==============================================================================
# Local development configuration.
#
# Copy to `.env` for `npm run dev` (wrangler dev) and for the Express fallback
# (`npm run dev:node`). `.env` is gitignored and must never be committed.
#
# On a deployed Worker this file is only a reference. Non-secret values belong in
# `wrangler.jsonc` under `vars`; the two Spotify credentials are secrets and must
# be set with `wrangler secret put` (see MIGRATION.md). Wrangler reads `.env` for
# local runs automatically, so local and production stay in sync.
# ==============================================================================

# Only used by the Express fallback server. Wrangler's dev server ignores it and
# serves on 8787.
PORT=3001

# Comma-separated exact origins allowed to call the API. No wildcards: CORS is
# sent with credentials, so an open `*` would let any site on the internet drive
# this user's browser at the API.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://spotuner.vercel.app

# Spotify Web API (optional).
#
# Both providers run simultaneously. Without these, Spotify is simply unavailable:
# YouTube remains the search, discovery and playback source, and nothing degrades.
#
# Values come from your Spotify developer dashboard. These are server-side only.
# SPOTIFY_CLIENT_SECRET must not reach the browser, a client bundle, an API
# response, or any storage the frontend can read.
#
#   Local:      put in .env
#   Production: npm run secret:spotify-id
#               npm run secret:spotify-secret
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Set to `off` to disable Spotify entirely without removing the credentials.
# SPOTIFY_METABRAINZ=off
# SPOTUNER_MUSICBRAINZ=off

# Discovery tuning
SPOTUNER_TTL_TRENDING_MS=1200000
SPOTUNER_TTL_LATEST_MS=2700000
SPOTUNER_TTL_CATALOG_MS=21600000
SPOTUNER_STALE_GRACE_MS=1800000
SPOTUNER_TRENDING_WINDOW_DAYS=210
SPOTUNER_RELEASE_WINDOW_DAYS=365
SPOTUNER_MIN_TRENDING_SCORE=12
SPOTUNER_MIN_LATEST_SCORE=18
SPOTUNER_REPETITION_WEIGHT=1
SPOTUNER_HYDRATE_LIMIT=90
SPOTUNER_META_CONCURRENCY=8

# Enrichment tuning. MusicBrainz is rate-limited to roughly one request per second,
# so ENRICH_LIMIT is the main control on how long a cold discovery run takes.
# SPOTUNER_ENRICH_LIMIT=24
# SPOTUNER_MAX_ENRICHERS=2
# SPOTUNER_MB_INTERVAL_MS=1050

# Artist image lookup (iTunes). No key required.
# SPOTUNER_ITUNES_INTERVAL_MS=110
# SPOTUNER_ITUNES_BACKOFF_MS=900000

# How many recent artist-image keys a cold isolate pulls into memory. Every KV read
# counts against the Worker's per-invocation subrequest ceiling, so this is a
# subrequest budget, not a cache size. Lower it on the free plan.
# SPOTUNER_ARTIST_PRIME_LIMIT=250

# Verbose language classification
# SPOTUNER_LANGUAGE_DEBUG=0
