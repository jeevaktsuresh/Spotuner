# Backend origin for local development.
#
# Copy to `.env` (which is gitignored - never commit it):
#   cp .env.example .env
#
# The deployed app is self-hosted: `deploy/serve.mjs` serves the built bundle and
# reverse-proxies `/api` to the backend, so production uses the same origin as the page:
#
#   VITE_API_URL=/
#
# which resolves every call to `/api` on whatever host served the page. Build with that:
#
#   npm run build            # reads .env, so set it there
#   VITE_API_URL=/ npm run build
#
# A value that already ends in `/api` is accepted as-is, so these are equivalent:
#   VITE_API_URL=/
#   VITE_API_URL=http://localhost:3001
#
# Do not put secrets here. Anything prefixed with VITE_ is inlined into the public
# client bundle at build time - Spotify credentials, tokens and API keys must never be
# added, or they become readable by anyone using the site.
VITE_API_URL=http://localhost:3001