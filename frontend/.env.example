# Backend origin for local development.
#
# Copy to `.env` (which is gitignored — never commit it):
#   cp .env.example .env
#
# Production does NOT use this file. Set `VITE_API_URL` in the Vercel project
# settings to https://spotunerbackend.jeevak3358.workers.dev
#
# The value is the backend origin. The `/api` prefix is appended automatically, and
# a value that already ends in `/api` is accepted as-is, so both of these work:
#   VITE_API_URL=http://localhost:3001
#   VITE_API_URL=http://localhost:3001/api
#
# Do not put secrets here. Anything prefixed with VITE_ is inlined into the public
# client bundle at build time — Spotify credentials, Cloudflare tokens and API keys
# must never be added, or they become readable by anyone using the site.
VITE_API_URL=http://localhost:3001